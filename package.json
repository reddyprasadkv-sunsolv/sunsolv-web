{
  "name": "sunsolv-redesign",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "node scripts/generate-sitemap.mjs && ng build --configuration production && ng run sunsolv-redesign:server:production && node scripts/prerender.mjs && ng run sunsolv-redesign:server-app:production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server-app.json",
    "format": "prettier --write src angular.json package.json tsconfig*.json",
    "format:check": "prettier --check src angular.json package.json tsconfig*.json",
    "serve:ssr:sunsolv-redesign": "RUN_SUNSOLV_SERVER=true node dist/sunsolv-redesign/server-app/main.js"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "22.1.2",
    "@angular/compiler": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@angular/platform-server": "22.1.2",
    "@angular/router": "22.1.2",
    "@angular/ssr": "22.1.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@ng-icons/core": "34.0.0",
    "@ng-icons/heroicons": "34.0.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.8",
    "@angular/build": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler-cli": "22.1.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "msgpackr-extract@3.0.4": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true
  }
}
